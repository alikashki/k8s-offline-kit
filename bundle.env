# bundle.env — BUILD-TIME settings: what gets downloaded by prepare-bundle.sh.
# Shipped inside the bundle; do NOT edit on the nodes (it must match what was downloaded).
# Change only when you want a different Kubernetes/Cilium version, then rebuild the bundle.

K8S_MINOR="v1.36"            # pkgs.k8s.io repo channel
K8S_PKG_VERSION=""           # optional exact deb version, e.g. "1.36.2-1.1" (empty = latest in channel)
CILIUM_VERSION="1.20.1"

# Helm values for Cilium. Used at build time (to discover images) AND at install time.
CILIUM_SET=(--set ipam.mode=kubernetes)

# metrics-server add-on (used by prepare-metrics-server.sh only). Empty = latest chart at build time.
METRICS_SERVER_CHART_VERSION=""