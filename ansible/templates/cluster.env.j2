# cluster.env — generated by Ansible from inventory.ini + group_vars/all.yml. Do not edit by hand.
VIP="{{ vip }}"
CONTROL_PLANE_ENDPOINT="${VIP}:6443"
POD_CIDR="{{ pod_cidr }}"

VRRP_INTERFACE="{{ vrrp_interface }}"
VRRP_PREFIX="{{ vrrp_prefix }}"
VRRP_ID="{{ vrrp_id }}"
VRRP_AUTH_PASS="{{ vrrp_auth_pass }}"

HOSTS_ENTRIES=(
{% for h in groups['lb'] + groups['control_plane'] + groups['workers'] %}
  "{{ hostvars[h]['node_ip'] }} {{ h }}"
{% endfor %}
  "${VIP} k8s-api.lab k8s-api"
)

METRICS_SERVER_SET=(
  --set replicas={{ metrics_server_replicas }}
{% if metrics_server_insecure_tls | bool %}
  --set "args[0]=--kubelet-insecure-tls"
{% endif %}
)