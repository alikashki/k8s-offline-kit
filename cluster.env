# cluster.env — PER-ENVIRONMENT settings (IPs, VIP, pod network, VRRP).
# Edit freely on the nodes for each infrastructure; no need to rebuild the bundle.
# Used by BOTH install-node.sh (k8s nodes) and install-lb.sh (load balancers).

# ---- API endpoint ----
VIP="<Change_This>"                      # keepalived VIP = cluster endpoint
CONTROL_PLANE_ENDPOINT="${VIP}:6443"
POD_CIDR="10.244.0.0/16"

# ---- keepalived (install-lb.sh) ----
VRRP_INTERFACE="<Change_This(like eth1 or ens33)>"
VRRP_PREFIX="24"
VRRP_ID="51"
VRRP_AUTH_PASS="<Change_This>"                   # 1-8 alphanumerics, IDENTICAL on both LBs (e.g. shuf -i 10000-99999 -n1)

# ---- /etc/hosts block written on every node (EDIT the IPs) ----
# Rule for install-lb.sh: every entry whose FIRST name matches cpN becomes a haproxy backend (:6443).
HOSTS_ENTRIES=(
  "192.168.10.11 lb1"
  "192.168.10.12 lb2"
  "192.168.10.21 cp1"
  "192.168.10.22 cp2"
  "192.168.10.23 cp3"
  "192.168.10.31 worker1"
  "192.168.10.32 worker2"
  "192.168.10.33 worker3"
  "${VIP} k8s-api.lab k8s-api"
)

# ---- metrics-server add-on (install-node.sh metrics-server) ----
# --kubelet-insecure-tls: kubeadm kubelets use self-signed serving certs, so metrics-server cannot verify
# them. Fine for a lab; remove it once kubelet serving certificates are signed by the cluster CA.
METRICS_SERVER_SET=(
  --set replicas=2
  --set "args[0]=--kubelet-insecure-tls"
)